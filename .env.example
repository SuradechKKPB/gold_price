# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Supabase (gold project). URL is public; service-role key is secret (server/ETL only).
SUPABASE_URL=https://wdcwhvqjazyvuqzvczlv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LINE Messaging API channel access tokens (long-lived), one per Official Account.
# Broadcast bills PER FOLLOWER against a 300-message/month free quota, so sends fail over
# to the second OA once the first is spent. Every family member must add BOTH OAs.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ACCESS_TOKEN_2=

# Holding config — drives the backtest unit and the headline THB figure.
GOLD_GRAMS=900
GOLD_TYPE=bar          # bar = 96.5% ทองคำแท่ง (15.244 g/baht-weight)
BAR_SPREAD_THB=200     # modeled buy-in = sell - spread when live bid is unknown

# Sell-campaign overlay (etl/advice.py). All optional — leave unset to disable.
# SELL_WINDOW_START=          # ISO date the exit window opened; enables deadline decay
# SELL_WINDOW_MONTHS=12
# TARGET_THB=0                # total proceeds goal for the whole holding
# COST_BASIS_THB_PER_BAHT=0   # avg buy price per baht-weight, for P/L framing

# NOT used here — set as a Cloudflare Worker secret only (gates worker/ test routes):
#   TRIGGER_KEY
